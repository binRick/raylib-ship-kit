// Windows resources: the .exe's icon, manifest and version details (compiled by windres;
// version.h is written by CMakeLists.txt from kit.env and VERSION).
#include "version.h"
1 ICON "icon.ico"
1 24 "app.manifest"  // RT_MANIFEST: UTF-8 file paths, per-monitor DPI aware
1 VERSIONINFO
FILEVERSION APP_VERSION_COMMA
PRODUCTVERSION APP_VERSION_COMMA
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", APP_NAME_STR
      VALUE "ProductName", APP_NAME_STR
      VALUE "FileVersion", APP_VERSION_STR
      VALUE "ProductVersion", APP_VERSION_STR
      VALUE "OriginalFilename", APP_EXE_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
