# The only file you edit to make the kit yours. One KEY="value" per line, no trailing comments.
# Display name: window title, .app name, home-screen label.
APP_NAME="Star Catcher"
# Binary / archive name: lowercase, no spaces.
APP_SLUG="starcatcher"
# Reverse-DNS id for macOS, iOS and App Store Connect.
BUNDLE_ID="com.example.starcatcher"
APP_CATEGORY="public.app-category.arcade-games"
# raylib release every platform builds against.
RAYLIB_TAG="6.2"
